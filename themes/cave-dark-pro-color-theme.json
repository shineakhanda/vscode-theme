    "quickInputTitle.background": "#1b1d29",
    "sash.hoverBorder": "#7aa2f7",
    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.activeBackground": "#ffffff26",
    "scrollbarSlider.background": "#ffffff0d",
    "scrollbarSlider.hoverBackground": "#ffffff1a",
    "selection.background": "#7aa2f744",
    "sideBar.background": "#15161e",
    "sideBar.border": "#ffffff0d",
