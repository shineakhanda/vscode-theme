    "sideBarSectionHeader.background": "#15161e",
    "sideBarSectionHeader.border": "#ffffff0d",
    "sideBarSectionHeader.foreground": "#a9b1d6",
    "sideBarTitle.foreground": "#5c6488",
    "statusBar.background": "#15161e",
    "statusBar.border": "#ffffff0d",
    "statusBar.debuggingBackground": "#ff9e6422",
    "statusBar.debuggingForeground": "#ff9e64",
    "statusBar.foreground": "#5c6488",
    "statusBar.noFolderBackground": "#15161e",
    "statusBarItem.errorBackground": "#f7768e22",
    "statusBarItem.errorForeground": "#f7768e",
    "statusBarItem.hoverBackground": "#ffffff0d",
    "statusBarItem.prominentBackground": "#ffffff0d",
    "statusBarItem.remoteBackground": "#00000000",
    "statusBarItem.remoteForeground": "#7aa2f7",
