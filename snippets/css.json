{
  "Flex Center": {
    "prefix": "flex-center",
    "body": ["display: flex;", "justify-content: center;", "align-items: center;"],
    "description": "Center children with flexbox"
  },
  "Grid Auto Fit": {
    "prefix": "grid-fit",
    "body": ["display: grid;", "grid-template-columns: repeat(auto-fit, minmax(${1:240px}, 1fr));", "gap: ${2:1rem};"],
    "description": "Responsive auto-fit grid"
  },
  "Media Query": {
    "prefix": "mq",
    "body": ["@media (max-width: ${1:768px}) {", "  $0", "}"],
    "description": "Max-width media query"
  },
  "Visually Hidden": {
    "prefix": "sr-only",
    "body": ["position: absolute;", "width: 1px;", "height: 1px;", "padding: 0;", "margin: -1px;", "overflow: hidden;", "clip: rect(0, 0, 0, 0);", "white-space: nowrap;", "border: 0;"],
    "description": "Hide visually but keep for screen readers"
  }
}
