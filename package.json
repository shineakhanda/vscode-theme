{
  "name": "cave-dark-pro",
  "displayName": "Cave Dark Pro",
  "description": "A modern, calm dark theme with a matching file-icon set, by Shine (Cave Technologies).",
  "version": "1.2.0",
  "publisher": "shineakhanda",
  "author": {
    "name": "Shine",
    "email": "shineert35@gmail.com",
    "url": "https://github.com/shineakhanda"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shineakhanda/vscode-theme.git"
  },
  "bugs": {
    "url": "https://github.com/shineakhanda/vscode-theme/issues"
  },
  "homepage": "https://github.com/shineakhanda/vscode-theme#readme",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes",
    "Snippets"
  ],
  "keywords": [
    "theme",
    "dark",
    "dark theme",
    "icon theme",
    "file icons",
    "snippets",
    "react",
    "web development",
    "cave"
  ],
  "galleryBanner": {
    "color": "#16171f",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "label": "Cave Dark Pro",
        "uiTheme": "vs-dark",
        "path": "./themes/cave-dark-pro-color-theme.json"
      }
    ],
    "snippets": [
      {
        "language": "html",
        "path": "./snippets/html.json"
      },
      {
        "language": "css",
        "path": "./snippets/css.json"
      },
      {
        "language": "scss",
        "path": "./snippets/css.json"
      },
      {
        "language": "javascript",
        "path": "./snippets/javascript.json"
      },
      {
        "language": "typescript",
        "path": "./snippets/javascript.json"
      },
      {
        "language": "javascriptreact",
        "path": "./snippets/javascript.json"
      },
      {
        "language": "typescriptreact",
        "path": "./snippets/javascript.json"
      },
      {
        "language": "javascriptreact",
        "path": "./snippets/react.json"
      },
      {
        "language": "typescriptreact",
        "path": "./snippets/react.json"
      }
    ],
    "iconThemes": [
      {
        "id": "cave-icons",
        "label": "Cave Icons",
        "path": "./themes/cave-icons.json"
      }
    ]
  },
  "scripts": {
    "build": "python scripts/build-vsix.py",
    "build:theme": "python scripts/build-vsix.py --theme-only",
    "install-theme": "python scripts/build-vsix.py --theme-only && code --install-extension cave-dark-pro-theme-only-1.2.0.vsix --force"
  }
}
